{
  "expo": {
    "name": "PwnShop",
    "slug": "pwnshop-mobile",
    "owner": "ctfsecurity",
    "version": "1.0.0",
    "scheme": "pwnshop",
    "orientation": "portrait",
    "icon": "./assets/pwnshop-icon.png",
    "platforms": [
      "android"
    ],
    "splash": {
      "image": "./assets/pwnshop-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a0033"
    },
    "android": {
      "package": "com.r007sec.pwnshop",
      "adaptiveIcon": {
        "foregroundImage": "./assets/pwnshop-icon.png",
        "backgroundColor": "#1a0033"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "pwnshop",
              "host": "admin"
            },
            {
              "scheme": "pwnshop",
              "host": "wallet"
            },
            {
              "scheme": "pwnshop",
              "host": "checkout"
            },
            {
              "scheme": "pwnshop",
              "host": "user",
              "pathPattern": "/.*"
            },
            {
              "scheme": "pwnshop",
              "host": "order",
              "pathPattern": "/.*"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "2d635f7b-5b9b-4e45-8d3b-b0fd302b1b4d"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ]
  }
}
